# ============================================================
#  Polymarket Signal Scalp Bot -- configuration template
#  Copy this file to .env and fill in YOUR values:
#    Windows (PowerShell):  Copy-Item .env.example .env
#    Linux / macOS:         cp .env.example .env
# ============================================================

# ── Window & stake ──
WINDOW=14400            # window length in seconds: 900 (15m), 14400 (4h), 86400 (1d)
STAKE=1                 # stake per position ($)
DEMO_START_BALANCE=100  # starting demo balance ($)

# ── Risk protection ──
MAX_DRAWDOWN_PCT=20     # stop if drawdown from peak >= 20%
MAX_DAILY_LOSS_PCT=15   # stop if daily loss >= 15%
MAX_REAL_STAKE=25       # max amount per single real order ($)
MAX_WINDOW_EXPOSURE=25  # max total funds locked per window ($)
MAX_BUY=0.95            # max token buy price (0-1)

# ── Number of positions ──
SIG_MAX_POS=6           # max simultaneous positions
SIG_REENTRY_CD=1800     # cooldown (sec) before re-entering the same coin

# ── Entry blackout ──
# The bot opens no new positions and no scale-ins within the last N minutes
# of the window.
SIG_ENTRY_CUTOFF_MIN=30

# ── Signal (1h trend) ──
SIG_MA_FAST=12          # fast moving average (hours)
SIG_MA_SLOW=48          # slow moving average (hours)
SIG_RSI_PERIOD=14       # RSI period
SIG_MIN_MA_GAP=0.001    # minimum MA gap for a signal (0.001 = 0.1%)
SIG_PRICE_MIN=0.10      # never buy below this price
SIG_PRICE_MAX=0.90      # never buy above this price
SIG_SPREAD_MAX=0.16     # max allowed order-book spread (ask-bid)

# ── Exit: trailing instead of fixed TP ──
# High TP (does not cut runners), profit is locked by trail/lock from the peak.
SIG_TP=0.30             # full take-profit (+30%)
SIG_TRAIL_PCT=0.16      # exit when price drops 16% from the peak
SIG_LOCK_ARM_PCT=0.06   # trail arms once the position shows +6% from entry
SIG_LOCK_GIVE=0.65      # lock 65% of the peak profit on a pullback
# Do not cut positions at the start of the window (signal is still noisy):
SIG_MIN_HOLD_BEFORE_REVERSAL=0.5
SIG_MIN_HOLD_BEFORE_TRAIL=1
# Sell a hopeless position at market near window end instead of riding to -100%:
SIG_HOPELESS_PRICE=0.20
SIG_HOPELESS_MIN_LEFT=30
SIG_MAX_HOLD_H=36       # max position holding time (hours)

# ── Decision loop frequency ──
SIG_POLL=5              # seconds between entry/exit checks (lower = faster reaction)

# ── Tranches (partial position sizing) ──
SIG_ENTRY_TRANCHES=1    # 1 = all capital at once; 3 = enter in parts
SIG_SCALE_MAX_ADVERSE=0.05  # skip next tranche if price moved >5% against us
SIG_PARTIAL_TP_PCT=0.08     # partial TP per packet (+8%)
SIG_PARTIAL_SL_PCT=0.10     # partial SL per packet (-10%)

# ── Polymarket wallet type ──
# 3 = Deposit Wallet (EIP-1271). 1 = Poly Proxy.
# If Polymarket Settings says "Do not send funds to this address" -- sig_type=3.
SIGNATURE_TYPE=3
CHAIN_ID=137

# ── REAL mode (fill in only you, locally) ──
# Safety: both must be enabled manually, otherwise orders are NOT sent.
DRY_RUN=1               # 1 = orders NOT sent (safe). 0 = live orders.
LIVE_TRADING=0          # 0 = blocked. 1 = allow (together with DRY_RUN=0).

# Polygon wallet and CLOB keys -- put YOUR own (required only for LIVE mode):
PRIVATE_KEY=
FUNDER_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── TELEGRAM (required even for demo: it is the control panel) ──
# Get a token from @BotFather: https://t.me/BotFather -- command /newbot.
# CHAT_ID: message your bot /start, then open
#          https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#          and copy the "chat":{"id": ...} value from the latest message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
